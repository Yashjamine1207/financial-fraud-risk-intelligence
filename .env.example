# Application
APP_ENV=development
APP_NAME=financial-fraud-risk-intelligence
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_intelligence
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_this_local_password

# Dataset paths
IEEE_CIS_RAW_PATH=data/raw/ieee_cis
PAYSIM_RAW_PATH=data/raw/paysim

# Model and experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_NAME=fraud-risk-model

# Decision policy
REVIEW_CAPACITY_PER_DAY=1000
FALSE_NEGATIVE_COST=500.0
FALSE_POSITIVE_REVIEW_COST=5.0
FRAUD_PREVENTION_VALUE=500.0

# API
API_HOST=0.0.0.0
API_PORT=8000